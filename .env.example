# Copy to .env and fill in, then: set -a; source .env; set +a
MOONSHOT_API_KEY=sk-...

# Optional: Claude Code's model for the proposer. The default, kimi-k3, runs it on Kimi with your Moonshot key;
# a Claude model (e.g. opus) uses your own Claude account instead.
# HW2_PROPOSER_MODEL=kimi-k3

# Turn off Harbor's usage telemetry
HARBOR_TELEMETRY=0
